#!/usr/bin/env bash
#
# AdaptiveSound pre-push hook (T1): the fast, whole-repo part of the gate, run by git before a push.
#
# It is the registry's `push` tier (scripts/gate/steps.tsv): toolchain parity first, then SwiftFormat,
# SwiftLint, semgrep, the suppression policy, the posture guards and actionlint over TRACKED files.
# Anything heavier (builds, tests, clang-tidy, Periphery, the sanitizers) is `make check` (T2) or
# `make combine-check` (T3) and CI. Bypass once, not recommended: git push --no-verify.
set -uo pipefail
repo_root="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo_root" || exit 1
# Git exports GIT_DIR (and friends) to every hook. In a worktree GIT_DIR is absolute, and a step that runs
# git in another repository — parity reading the GoogleTest submodule's commit — would read THIS one
# instead (it reported the superproject's HEAD and failed every push from a worktree). The gate finds the
# repository itself, from the working directory, as it does outside a hook.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX
"$repo_root/scripts/gate/run.sh" --tier push
rc=$?
if ((rc != 0)); then
    echo "push aborted by the pre-push gate (T1). Fix the failures above, or run 'make check' for the full lane bar." >&2
fi
exit "$rc"
