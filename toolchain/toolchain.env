# toolchain/toolchain.env — the ONE manifest of every tool that can change a gate verdict.
#
# Shell-sourceable KEY=value lines (no arithmetic, no quoting tricks) so bash, make and GitHub
# Actions can all read it. Read by:
#   - scripts/toolchain/install.sh   (downloads + checksums into ~/.cache/adaptivesound-toolchain/<hash>/)
#   - scripts/toolchain/check.sh     (the parity table: exact for verdict tools, warn-local/fail-CI for the rest)
#   - scripts/gate/*.sh              (pins the Swift/C++ tool versions the gate asserts)
#   - .github/workflows/*.yml        (the Xcode selection and the tool install, via install.sh)
#
# A bump is ONE commit: `toolchain: bump X a→b`, changing this file AND fixing the new findings.
# Never mix a bump into a feature change. Never loosen an exact pin to make a check pass.
#
# Checksums are GitHub's own release-asset digests (sha256), verified against the downloaded bytes
# when this file was written (2026-10-21). Where a release publishes no digest, the value is the
# one previously pinned in strict-ci.yml / the Homebrew cask, and the source is named in the comment.

# ---- Xcode / OS (CI selects this Xcode by path; local parity compares `xcodebuild -version`) ----
XCODE_VERSION=27.1
XCODE_BUILD=27A9275
SWIFT_VERSION=6.4
# The runner. GitHub's Xcode 27 PREVIEW image (macOS 27.0.1); Xcode 27.0 is its default, so CI selects
# 27.1 by path: /Applications/Xcode_27.1.app (an alias of Xcode_27.1_Release_Candidate.app, build 27A9275).
RUNNER_LABEL=xcode-27
XCODE_APP_PATH=/Applications/Xcode_27.1.app
# The CI runner image must be at least this date (YYYYMMDD) or the static job fails with instructions.
RUNNER_IMAGE_MIN=20261012
# macOS on the CI image vs the founder's Mac. INFO ONLY: the founder accepted the difference (26.6 Mac,
# 27.0.1 CI). It is printed in the parity table and never fails. Residual risk: CI runs macOS 27 while
# the product targets macOS 26 (see scripts/toolchain/check.sh's binary deployment-target check).
MACOS_CI_IMAGE=27.0.1
# --swiftversion passed to SwiftFormat. Unset today; enabled in its own bump commit (architect §3.4).
SWIFT_FORMAT_LANGUAGE=

# ---- Swift style and dead code (GitHub release zips; exact, checksummed) ----
SWIFTFORMAT_VERSION=0.63.0
SWIFTFORMAT_URL=https://github.com/nicklockwood/SwiftFormat/releases/download/0.63.0/swiftformat.zip
SWIFTFORMAT_SHA256=28c7802e11fa5ae113d903066439c6bb1be20a8ac1ad9709c42616a7e273fb0f

SWIFTLINT_VERSION=0.65.1
SWIFTLINT_URL=https://github.com/realm/SwiftLint/releases/download/0.65.1/portable_swiftlint.zip
SWIFTLINT_SHA256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0

# Periphery: the SHA is the one the Homebrew tap's own cask pins (no GitHub digest is published).
PERIPHERY_VERSION=2.21.2
PERIPHERY_URL=https://github.com/peripheryapp/periphery/releases/download/2.21.2/periphery-2.21.2.zip
PERIPHERY_SHA256=e5b4e802f794df230a2e4b9d5bb176626b3a9fd74ea6cf7d0d42c20ebe57fd4a

# ---- C++ analysis: clang-tidy AND clang-format from ONE LLVM (upstream macOS arm64 tarball) ----
LLVM_VERSION=23.1.3
LLVM_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.3/LLVM-23.1.3-macOS-ARM64.tar.xz
LLVM_SHA256=3dcfd88aec10be204a24037bcb0dc0ad777882e9dbe8ac60e2639060d8a794b1
# Major the existing C++ analysis library pins (scripts/lib/cxx-analysis-flags.sh). The parity check
# asserts it equals LLVM_VERSION's major, so the two cannot drift silently.
LLVM_MAJOR=23

# cppcheck has no macOS binary release: built from the pinned source tarball, then cached.
CPPCHECK_VERSION=2.22.0
CPPCHECK_URL=https://github.com/danmar/cppcheck/archive/refs/tags/2.22.0.tar.gz
CPPCHECK_SHA256=d74945deb2d50393430e07596b766f8a779512c7f60dac2a30ea64e059ece57b

# Python for the semgrep venv. The hash-locked wheels are built for this minor version (M2): the
# installer uses python$PYTHON_VERSION from PATH and fails clearly without it. Not the image default.
PYTHON_VERSION=3.12

# semgrep: pip, hash-locked (scripts/toolchain/semgrep-requirements.txt), installed --require-hashes
# into a private venv inside the cache. The version here must equal that file's `semgrep==` line.
SEMGREP_VERSION=1.180.0

# actionlint: the workflow linter, used by the static job and the canary (darwin arm64 tarball).
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_URL=https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_darwin_arm64.tar.gz
ACTIONLINT_SHA256=aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f

# ShellCheck lints every tracked *.sh and the git hooks, and the workflows' run: blocks (actionlint calls it from PATH).
# The darwin.aarch64 archive is the one this Mac and the runners use. Digest: GitHub's published asset digest,
# checked against the downloaded bytes.
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_URL=https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.darwin.aarch64.tar.gz
SHELLCHECK_SHA256=339b930feb1ea764467013cc1f72d09cd6b869ebf1013296ba9055ab2ffbd26f

# FFmpeg: deliberately NOT pinned here. The gate works with any FFmpeg (or none); scripts/toolchain/check.sh
# prints the version and whether the FFmpeg analysis branch is on, as INFO. See the review, finding B3.

# C++ test framework (git submodule third_party/googletest; check.sh asserts the commit)
GOOGLETEST_VERSION=1.18.0
GOOGLETEST_COMMIT=063de7e9578f82b369302001269680b4b1553359
